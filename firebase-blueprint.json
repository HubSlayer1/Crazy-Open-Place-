      },
      "required": [
        "id",
        "orderId",
        "customerId",
        "ranOver30MinZeroGlory",
        "runningMinutesObserved",
        "failureExplanation",
        "status",
        "providerRefundResult",
        "customerRefundResult",
        "createdAt",
        "updatedAt"
      ]
    },
