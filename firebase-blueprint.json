  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated admin user profile documents."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Explicit admin allowlist documents."
    },
    "/guildPackages/{packageId}": {
      "schema": { "$ref": "#/entities/GuildPackage" },
      "description": "Storefront Guild Glory packages; enabled items publicly readable, all managed by admin."
    },
    "/guildSettings/{settingId}": {
      "schema": { "$ref": "#/entities/GuildSettings" },
      "description": "Private admin settings document (main)."
    },
    "/publicStorefront/{documentId}": {
      "schema": { "$ref": "#/entities/PublicStorefrontCheckout" },
      "description": "Customer-safe public checkout projection at /publicStorefront/checkout."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
