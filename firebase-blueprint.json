{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated administrator profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator registry document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "GuildPackage": {
      "title": "GuildPackage",
      "description": "FF Guild Glory package configuration displayed on the storefront.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "botQuantity": { "type": "number" },
        "priceAmount": { "type": "number" },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "durationLabel": { "type": "string", "maxLength": 160 },
        "supportedRegions": { "type": "array" },
        "description": { "type": "string", "maxLength": 2000 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "warnings": { "type": "string", "maxLength": 2000 },
        "refundNote": { "type": "string", "maxLength": 2000 },
        "providerPriceNote": { "type": "string", "maxLength": 500 },
        "estimatedDelivery": { "type": "string", "maxLength": 240 },
        "enabled": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "botQuantity",
        "priceAmount",
        "currency",
        "supportedRegions",
        "enabled",
        "sortOrder",
        "updatedAt"
      ]
    },
    "GuildSettings": {
      "title": "GuildSettings",
      "description": "Private admin configuration for Guild Glory & FFGlory provider.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["main"] },
        "providerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "providerHomepage": { "type": "string", "maxLength": 120 },
        "providerTrackingUrl": { "type": "string", "maxLength": 120 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "supportedHandoffMethod": { "type": "string", "maxLength": 300 },
        "providerTransactionFieldsNote": { "type": "string", "maxLength": 1000 },
        "serviceInstructions": { "type": "string", "maxLength": 4000 },
        "paymentInstructions": { "type": "string", "maxLength": 4000 },
        "importantWarnings": { "type": "string", "maxLength": 4000 },
        "refundConditions": { "type": "string", "maxLength": 4000 },
        "supportWhatsapp": { "type": "string", "maxLength": 64 },
        "supportEmail": { "type": "string", "maxLength": 254 },
        "supportHours": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
