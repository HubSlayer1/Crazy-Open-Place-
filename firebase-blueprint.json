        "binanceOrderId": { "type": "string", "maxLength": 120 },
        "providerAccountUsername": { "type": "string", "maxLength": 120 },
        "paymentProofUrl": { "type": "string", "maxLength": 512 },
        "paymentSubmittedAt": { "type": "string", "format": "date-time" },
        "paymentVerifiedAt": { "type": "string", "format": "date-time" },
        "paymentAdminNote": { "type": "string", "maxLength": 1000 },
        "providerGroupId": { "type": "string", "maxLength": 120 },
        "activationTransactionRef": { "type": "string", "maxLength": 120 },
        "customerActivationStatus": { "type": "string", "maxLength": 64 },
        "redeemCode": { "type": "string", "maxLength": 120 },
        "activationProofUrl": { "type": "string", "maxLength": 512 },
        "activationSubmittedAt": { "type": "string", "format": "date-time" },
        "activationVerifiedAt": { "type": "string", "format": "date-time" },
        "activationAdminNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
