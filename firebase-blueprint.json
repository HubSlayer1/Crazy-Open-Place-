        "providerName": { "type": "string", "maxLength": 80 },
        "providerUrl": { "type": "string", "maxLength": 120 },
        "paymentStatus": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 },
        "trackingHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "lastProofId": { "type": "string", "maxLength": 128 },
        "providerTransactionId": { "type": "string", "maxLength": 120 },
        "binanceOrderId": { "type": "string", "maxLength": 120 },
        "providerAccountUsername": { "type": "string", "maxLength": 120 },
        "paymentProofUrl": { "type": "string", "maxLength": 512 },
        "paymentSubmittedAt": { "type": "string", "format": "date-time" },
        "paymentVerifiedAt": { "type": "string", "format": "date-time" },
        "paymentVerifiedBy": { "type": "string", "maxLength": 254 },
        "paymentAdminNote": { "type": "string", "maxLength": 1000 },
        "providerGroupId": { "type": "string", "maxLength": 120 },
        "activationTransactionRef": { "type": "string", "maxLength": 120 },
        "customerActivationStatus": { "type": "string", "maxLength": 64 },
        "redeemCode": { "type": "string", "maxLength": 120 },
        "activationProofUrl": { "type": "string", "maxLength": 512 },
        "activationSubmittedAt": { "type": "string", "format": "date-time" },
        "activationVerifiedAt": { "type": "string", "format": "date-time" },
        "activationVerifiedBy": { "type": "string", "maxLength": 254 },
        "activationAdminNote": { "type": "string", "maxLength": 1000 },
        "legacyCustomerRef": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "orderReference",
        "customerId",
        "idempotencyKey",
        "packageId",
        "packageName",
        "botQuantity",
        "quantityMultiplier",
        "totalBots",
        "unitPrice",
        "totalAmount",
        "currency",
        "guildId",
        "region",
        "whatsapp",
        "providerName",
        "providerUrl",
        "status",
        "trackingHash",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderTimelineEvent": {
      "title": "OrderTimelineEvent",
      "description": "Immutable timestamped status/audit entry under orders/{orderId}/timeline.",
