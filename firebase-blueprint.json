    "OrderPinProof": {
      "title": "OrderPinProof",
      "description": "Single-use capability proof created in atomic batch with order mutations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "trackingHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderId", "trackingHash", "createdAt"]
    },
    "ProviderTxLock": {
      "title": "ProviderTxLock",
      "description": "Atomic uniqueness lock preventing replay of FFGlory transaction IDs across orders.",
      "type": "object",
      "properties": {
        "txKey": { "type": "string", "minLength": 3, "maxLength": 128 },
        "rawTxId": { "type": "string", "minLength": 3, "maxLength": 120 },
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "trackingHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "proofId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["txKey", "rawTxId", "orderId", "customerId", "createdAt"]
    },
    "PublicOrderTracking": {
      "title": "PublicOrderTracking",
      "description": "Minimal zero-PII order status projection keyed by SHA-256(orderReference:trackingCode).",
      "type": "object",
      "properties": {
        "orderReference": { "type": "string", "minLength": 1, "maxLength": 128 },
