      "required": [
        "providerName",
        "providerHomepage",
        "currency",
        "serviceInstructions",
        "paymentInstructions",
        "importantWarnings",
        "refundConditions",
        "updatedAt"
      ]
    },
    "PublicStorefrontCheckout": {
      "title": "PublicStorefrontCheckout",
      "description": "Customer-safe whitelist projection of storefront checkout & official FFGlory provider handoff instructions.",
      "type": "object",
      "properties": {
        "storefrontEnabled": { "type": "boolean" },
        "providerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "providerUrl": { "type": "string", "maxLength": 120 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "paymentInstructions": { "type": "string", "maxLength": 4000 },
        "serviceInstructions": { "type": "string", "maxLength": 4000 },
        "importantWarnings": { "type": "string", "maxLength": 4000 },
        "refundConditions": { "type": "string", "maxLength": 4000 },
        "providerTransactionFieldsNote": { "type": "string", "maxLength": 1000 },
        "enabledPaymentLabels": { "type": "array" },
        "supportWhatsapp": { "type": "string", "maxLength": 64 },
        "supportEmail": { "type": "string", "maxLength": 254 },
        "supportHours": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "storefrontEnabled",
        "providerName",
        "providerUrl",
        "currency",
        "paymentInstructions",
        "serviceInstructions",
        "importantWarnings",
        "refundConditions",
        "updatedAt"
      ]
    },
