      "required": [
        "orderReference",
        "packageName",
        "totalBots",
        "status",
        "providerName",
        "providerUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "RefundRequest": {
      "title": "RefundRequest",
      "description": "Customer refund claim & admin resolution record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "trackingHash": { "type": "string", "maxLength": 128 },
        "proofId": { "type": "string", "maxLength": 128 },
        "providerTransactionRef": { "type": "string", "maxLength": 120 },
        "providerGroupRef": { "type": "string", "maxLength": 120 },
        "ranOver30MinZeroGlory": { "type": "boolean" },
        "runningMinutesObserved": { "type": "number" },
        "failureExplanation": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["PENDING_REVIEW", "APPROVED", "REJECTED", "RESOLVED"] },
        "providerRefundResult": { "type": "string", "maxLength": 64 },
        "customerRefundResult": { "type": "string", "maxLength": 64 },
        "refundAmountLabel": { "type": "string", "maxLength": 120 },
