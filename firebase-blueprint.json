        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "customerId",
        "category",
        "subject",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "General Contact Us inquiry.",
