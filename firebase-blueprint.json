        "customerEmail": { "type": "string", "maxLength": 254 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "packageId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "botQuantity": { "type": "number" },
        "quantityMultiplier": { "type": "number" },
        "totalBots": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "guildId": { "type": "string", "minLength": 6, "maxLength": 20 },
        "guildName": { "type": "string", "maxLength": 100 },
        "region": { "type": "string", "minLength": 1, "maxLength": 20 },
